# Public site origin used in the sitemap, metadata and absolute links.
# Set this per Amplify branch:
#   staging  → https://test.cloudhight.com  (or the Amplify preview URL)
#   main     → https://cloudhight.com
NEXT_PUBLIC_SITE_URL=https://cloudhight.com

# Cloudflare Turnstile widget site key (safe to expose to the browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Do not commit real values.
TURNSTILE_SECRET_KEY=
CONTACT_RATE_LIMIT_TABLE=
